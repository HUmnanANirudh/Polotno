{
  "name": "polotno",
  "private": true,
  "type": "module",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "concurrently --names api,web --prefix-colors blue,green \"bun run dev:api\" \"bun run dev:web\"",
    "dev:api": "bun run --filter api dev",
    "dev:web": "bun run --filter web dev",
    "build": "bun run build:api && bun run build:web",
    "build:api": "bun run --filter api build",
    "build:web": "bun run --filter web build",
    "postinstall": "bun run --filter api db:generate"
  },
  "devDependencies": {
    "@types/bun": "latest",
    "concurrently": "^9.1.2"
  },
  "peerDependencies": {
    "typescript": "^5"
  }
}
