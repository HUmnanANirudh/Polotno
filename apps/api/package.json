{
  "name": "api",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "bun run db:generate && bun build ./src/server.ts --outdir ./dist --target node",
    "start": "node dist/server.js",
    "lint": "eslint",
    "postinstall": "prisma generate",
    "db:generate": "bunx prisma generate",
    "db:push": "bunx prisma db push"
  },
  "dependencies": {
    "@polotno/types": "workspace:*",
    "@prisma/client": "6.4.1",
    "bcryptjs": "^3.0.2",
    "cloudinary": "^2.6.1",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.6",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "jsonwebtoken": "^9.0.2",
    "multer": "^2.0.1",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/bcryptjs": "^3.0.0",
    "@types/bun": "latest",
    "@types/cookie-parser": "^1.4.8",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/jsonwebtoken": "^9.0.9",
    "@types/multer": "^1.4.12",
    "@types/node": "^26.5.1",
    "prisma": "6.4.1",
    "tsx": "^4.23.13"
  }
}
